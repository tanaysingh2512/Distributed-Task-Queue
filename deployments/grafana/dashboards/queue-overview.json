{
  "title": "Task Queue Overview",
  "uid": "taskqueue-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Queue Depth by Priority",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(taskqueue_queue_depth) by (queue, priority)",
          "legendFormat": "{{queue}} / {{priority}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Task Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(taskqueue_task_latency_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "p50 {{queue}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(taskqueue_task_latency_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "p95 {{queue}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(taskqueue_task_latency_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "p99 {{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Task Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(taskqueue_tasks_completed_total[5m])) by (queue, outcome)",
          "legendFormat": "{{queue}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Worker Health",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(taskqueue_worker_up)", "legendFormat": "workers up" }
      ]
    },
    {
      "id": 5,
      "title": "Leases Reclaimed (crash recovery)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(taskqueue_leases_reclaimed_total[5m])) by (queue)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Dead-Lettered Tasks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(taskqueue_tasks_completed_total{outcome=\"dead_lettered\"}[5m])) by (queue)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Retry Backoff Distribution",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(taskqueue_retry_backoff_seconds_bucket[5m])) by (le)",
          "format": "heatmap"
        }
      ]
    }
  ]
}
